# Postgres connection string (Render managed Postgres: use the "Internal Database URL"
# for the collector and web service once both live on Render; use the External URL
# for local development / migrations from your own machine)
DATABASE_URL=postgres://user:password@host:5432/geothermal_investment

# Claude API key (console.anthropic.com) — used by the collector for structured extraction
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the first extraction pass on every candidate article (cheap tier)
EXTRACTION_MODEL=claude-haiku-4-5

# Model used to re-run extraction when the first pass comes back ambiguous
# (missing amount/investor/recipient, or the model itself flags uncertainty)
ESCALATION_MODEL=claude-sonnet-4-5

# Confidence threshold below which a deal is queued for manual review instead of
# auto-published. One of: high, medium, low. "medium" means only "high" auto-publishes.
AUTO_PUBLISH_THRESHOLD=high

# Port for the web service (Render sets this automatically in production)
PORT=3000
